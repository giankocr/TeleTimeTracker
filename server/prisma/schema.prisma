// ============================================================================
//  TeleTimeTracker - Esquema de Base de Datos
//  Motor: SQLite (por defecto, volumen persistente) o PostgreSQL.
//  Para Postgres: cambiar provider a "postgresql" y DATABASE_URL.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
//  RBAC: Rol -> Permisos (lista separada por comas)
// ---------------------------------------------------------------------------
model Role {
  id          String   @id @default(cuid())
  key         String   @unique // ADMIN | MANAGER | USER  (o roles custom)
  name        String
  description String?
  // Lista de permisos separados por coma. "*" = superusuario.
  permissions String   @default("")
  isSystem    Boolean  @default(false) // los roles de sistema no se pueden borrar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
//  Usuarios (trabajadores / managers / admins)
// ---------------------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  isActive     Boolean   @default(true)
  // Rol RBAC
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  // Manager directo (jerarquia para reportes de equipo)
  managerId    String?
  manager      User?     @relation("TeamHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]    @relation("TeamHierarchy")

  // --- Vinculacion con Telegram ---
  telegramId       String?   @unique // chat/user id numerico de Telegram
  telegramUsername String?
  telegramLinkedAt DateTime?
  // Codigo efimero que el usuario envia al bot para vincular su cuenta
  telegramLinkCode String?   @unique
  telegramLinkExp  DateTime?

  // --- Telefono y acceso con codigo de un solo uso (OTP por el bot) ---
  phone           String?   @unique // normalizado E.164 (ej. +573001234567)
  phoneVerifiedAt DateTime?
  otpCodeHash     String? // SHA-256 del codigo de 6 digitos (nunca en claro)
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  otpLastSentAt   DateTime?

  // --- GitHub ---
  githubUsername String?
  githubToken    String? // token personal cifrado (AES-256-GCM)

  // --- Jornada laboral (para alertas de inactividad) ---
  workDays    String  @default("1,2,3,4,5") // 0=Dom ... 6=Sab
  workStart   String  @default("09:00")
  workEnd     String  @default("18:00")
  timezone    String  @default("America/Bogota")
  idleAlertMin Int    @default(45) // minutos sin tarea corriendo antes de alertar
  dailyDigest Boolean @default(true)

  locale          String    @default("es")
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  timeEntries     TimeEntry[]
  tasksAssigned   Task[]          @relation("TaskAssignee")
  tasksCreated    Task[]          @relation("TaskCreatedBy")
  pendingTasks    PendingTask[]
  sessions        AuthSession[]
  projectMembers  ProjectMember[]
  clientMembers   ClientMember[]
  alertLogs       AlertLog[]
  auditLogs       AuditLog[]
  botMessages     BotMessage[]

  @@index([roleId])
  @@index([managerId])
  @@map("users")
}

// ---------------------------------------------------------------------------
//  Clientes
// ---------------------------------------------------------------------------
model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ClientProject[]
  members  ClientMember[]
  entries  TimeEntry[]
  tasks    Task[]

  @@map("clients")
}

model ClientMember {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("client_members")
}

// ---------------------------------------------------------------------------
//  Proyectos (pertenecen a un cliente) y tipos de tarea (globales)
// ---------------------------------------------------------------------------
model ClientProject {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean  @default(true)
  // Integracion GitHub: "owner/repo" o lista separada por comas
  githubRepos    String?
  // Presupuesto de horas (para reportes de desvio)
  budgetHours    Float?
  hourlyRate     Float?
  // Minutos de gracia sobre la jornada antes de alertar inactividad
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members  ProjectMember[]
  entries  TimeEntry[]
  tasks    Task[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  id        String        @id @default(cuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Rol dentro del proyecto: OWNER | MEMBER | VIEWER
  role      String        @default("MEMBER")

  @@unique([projectId, userId])
  @@map("project_members")
}

model TaskType {
  id        String   @id @default(cuid())
  name      String   @unique // "Maquetacion", "Reunion", "Soporte"...
  // Alias separados por coma para que el NLU los reconozca en notas de voz
  aliases   String   @default("")
  color     String   @default("#6366f1")
  billable  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries TimeEntry[]
  tasks   Task[]

  @@map("task_types")
}

// ---------------------------------------------------------------------------
//  TAREA: la unidad de trabajo. NO es lo mismo que un registro de tiempo.
//
//  Una tarea (arreglar el login, maquetar el checkout) puede tener VARIOS
//  registros de tiempo: cada vez que se empieza, se pausa para otra cosa y se
//  retoma se crea un tramo nuevo. Asi el tiempo total de la tarea es la suma de
//  sus tramos, y el registro de tiempo sigue siendo el hecho puntual.
//
//  Jerarquia: Cliente -> Proyecto -> Tarea -> Registro de tiempo
//  ---------------------------------------------------------------------------
model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  // OPEN | IN_PROGRESS | DONE | CANCELLED
  status      String         @default("OPEN")
  projectId   String?
  project     ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  taskTypeId  String?
  taskType    TaskType?      @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  // Responsable principal (las tareas pueden ser de alguien concreto)
  assigneeId  String?
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  estimatedHours Float?
  priority       String  @default("NORMAL") // LOW | NORMAL | HIGH
  dueDate        DateTime?

  // --- Acumulados, mantenidos por el motor de tiempo ---
  totalSeconds Int       @default(0)
  entryCount   Int       @default(0)
  firstWorkedAt DateTime?
  lastWorkedAt  DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
//  TIEMPOS: TimeEntry = un segmento trabajado (un "lap") sobre un proyecto.
//  Regla de negocio: un usuario solo puede tener un segmento RUNNING a la vez.
//  Cambiar de tarea = cerrar el segmento actual (switchReason=SWITCH) y abrir otro.
// ---------------------------------------------------------------------------
model TimeEntry {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Tarea a la que pertenece este tramo. Una tarea agrupa VARIOS registros.
  taskId    String?
  task      Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  taskTypeId String?
  taskType  TaskType?     @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)

  // Texto libre tal como lo dijo el usuario (voz transcrita o texto)
  title       String?
  description String?

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  // Segundos trabajados acumulados (excluye pausas)
  durationSec Int       @default(0)
  billable    Boolean   @default(true)

  // RUNNING | PAUSED | FINISHED | CANCELLED
  status      String    @default("RUNNING")
  // Como se origino: TELEGRAM_VOICE | TELEGRAM_TEXT | TELEGRAM_BUTTON | WEB | API
  source      String    @default("TELEGRAM_TEXT")
  // Por que se cerro: SWITCH | FINISH | PAUSE | IDLE_TIMEOUT | MANUAL_WEB
  closeReason String?

  // Enriquecimiento GitHub (JSON serializado): commits/PRs del rango
  githubData  String?
  githubSyncedAt DateTime?

  // Otros usuarios han editado este registro (auditoria ligera)
  editedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pauses      Pause[]
  tags        EntryTag[]

  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([taskId])
  @@index([startedAt])
  @@map("time_entries")
}

model Pause {
  id          String    @id @default(cuid())
  entryId     String
  entry       TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  reason      String?

  @@index([entryId])
  @@map("pauses")
}

model EntryTag {
  id      String    @id @default(cuid())
  entryId String
  entry   TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     String

  @@unique([entryId, tag])
  @@map("entry_tags")
}

// ---------------------------------------------------------------------------
//  Tareas pendientes / backlog por usuario (alimenta la alerta diaria)
// ---------------------------------------------------------------------------
model PendingTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  title       String
  notes       String?
  // LOW | NORMAL | HIGH
  priority    String   @default("NORMAL")
  dueDate     DateTime?
  isDone      Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, isDone])
  @@map("pending_tasks")
}

// ---------------------------------------------------------------------------
//  Configuracion global (key-value; los secretos se cifran con SETTINGS_ENC_KEY)
// ---------------------------------------------------------------------------
model SystemSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
//  Sesiones JWT (permite revocar tokens: logout, reseteo de clave)
// ---------------------------------------------------------------------------
model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
//  Alertas enviadas (anti-spam: no repetir la misma alerta al mismo usuario)
// ---------------------------------------------------------------------------
model AlertLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // IDLE | DAILY_DIGEST | WEEKLY_SUMMARY
  type     String
  sentAt   DateTime @default(now())
  payload  String?

  @@index([userId, type, sentAt])
  @@map("alert_logs")
}

// ---------------------------------------------------------------------------
//  Auditoria de acciones del panel
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
//  Log crudo de mensajes del bot (trazabilidad y debugging del NLU)
// ---------------------------------------------------------------------------
model BotMessage {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramId String?
  chatId     String?
  kind       String   // TEXT | VOICE | COMMAND | CALLBACK
  rawText    String?
  transcript String?
  intent     String?
  entities   String?
  reply      String?
  ok         Boolean  @default(true)
  error      String?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("bot_messages")
}

// ---------------------------------------------------------------------------
//  Solicitudes de acceso desde el bot: alguien comparte su numero pero todavia
//  no tiene cuenta. Un administrador lo aprueba creando el usuario.
// ---------------------------------------------------------------------------
model BotContact {
  id            String   @id @default(cuid())
  telegramId    String   @unique
  phone         String
  firstName     String?
  lastName      String?
  username      String?
  // PENDING | LINKED | REJECTED
  status        String   @default("PENDING")
  // Usuario con el que quedo vinculado (si aplica)
  userId        String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@map("bot_contacts")
}
