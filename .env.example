# ============================================================================
#  TeleTimeTracker - Entorno de EJEMPLO
#  Copia este archivo a .env y ajusta los valores antes de desplegar.
#  En EasyPanel puedes pegar estas variables directamente en la pestana
#  "Environment" del servicio (no hace falta subir el .env al repositorio).
# ============================================================================

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Base de datos
#  - SQLite (por defecto): deja DATABASE_URL vacio o "file:/app/data/teletimetracker.db"
#    El archivo vive en el volumen persistente /app/data.
#  - PostgreSQL: descomenta la linea de abajo y crea el servicio Postgres en EasyPanel.
#    (Recuerda cambiar el provider a "postgresql" en server/prisma/schema.prisma)
# ---------------------------------------------------------------------------
DATA_DIR=/app/data
# DATABASE_URL=postgresql://usuario:password@postgres:5432/teletimetracker?schema=public

# Aplica migraciones y seed automaticamente al arrancar el contenedor.
AUTO_MIGRATE=true
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Seguridad (OBLIGATORIO cambiar en produccion)
#  Genera los secretos con:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
REFRESH_EXPIRES_DAYS=30
# Clave para cifrar los tokens guardados en la BD (Telegram/OpenAI/GitHub).
SETTINGS_ENC_KEY=
# Origenes permitidos por CORS ("*" o lista separada por comas)
CORS_ORIGINS=*
# Pon true si el panel se sirve por HTTPS detras de un proxy
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Administrador inicial (se crea en el primer arranque / seed)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@tudominio.com
# Clave SOLO para el primer arranque: cambiala en el panel (Mi perfil) al entrar.
ADMIN_PASSWORD=CambiaEstaClave123
ADMIN_NAME=Administrador

# ---------------------------------------------------------------------------
# Telegram
#  TELEGRAM_MODE:
#    webhook -> requiere PUBLIC_URL accesible (recomendado en EasyPanel)
#    polling -> el bot consulta a Telegram (util sin dominio propio)
#    off     -> desactiva el bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
# Cadena aleatoria que Telegram enviara en el header x-telegram-bot-api-secret-token
TELEGRAM_WEBHOOK_SECRET=
# URL publica del panel SIN barra final, ej: https://tiempo.tudominio.com
PUBLIC_URL=
# Solo para pruebas locales: apuntar la Bot API a un servidor simulado.
# En produccion debe quedar comentada (se usa https://api.telegram.org).
# TELEGRAM_API_BASE=http://127.0.0.1:9099

# ---------------------------------------------------------------------------
# IA: transcripcion de notas de voz + interpretacion de intenciones
#
# Hay DOS proveedores y se elige solo (el SDK es el mismo porque Groq es
# compatible con la API de OpenAI):
#   1. Groq  -> si defines GROQ_API_KEY  (recomendado: mas rapido y barato)
#   2. OpenAI-> si defines OPENAI_API_KEY
# ---------------------------------------------------------------------------

# --- Groq (recomendado para los audios) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.1-8b-instant

# --- OpenAI (alternativa / respaldo) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
NLU_MODEL=gpt-4o-mini
NLU_ENABLED=true

# ---------------------------------------------------------------------------
# GitHub (enriquecer el reporte con commits/PRs de la ventana trabajada)
#  El token tambien se puede configurar por usuario desde el panel (Perfil).
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ENRICH=true

# ---------------------------------------------------------------------------
# Alertas del bot
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
# Revisa inactividad cada minuto (formato cron)
ALERT_CRON=* * * * *
# Digest diario a las 08:00 de lunes a viernes
DIGEST_CRON=0 8 * * 1-5
DEFAULT_TIMEZONE=America/Bogota

# ---------------------------------------------------------------------------
# Extra
# ---------------------------------------------------------------------------
# Crea datos de ejemplo (cliente/proyecto/manager demo) al hacer el seed
SEED_DEMO=false
# Repo de GitHub usado en los datos demo, formato owner/repo
SEED_DEMO_REPO=
